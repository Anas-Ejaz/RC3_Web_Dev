# ---- App ----
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000 # exact origin allowed by CORS (no trailing slash)

# ---- Database (Neon/Supabase: use their URL, keep the +psycopg driver, add sslmode=require) ----
DATABASE_URL=postgresql://neondb_owner:npg_wzRWSty7LJK2@ep-quiet-tree-azy7a59l-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ---- Auth ----
JWT_SECRET=2lNQmgb6vAGBj-et-tNt2hL9pl0brEeNU3s1F5dP7g_WTgtYMF0prhDu4UDKaT5T9_W2qmlb-NkVhLXf4OpG_A
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_NAME=access_token
COOKIE_SECURE=false                # true in production (HTTPS)
COOKIE_SAMESITE=lax                # use "none" if frontend and API are on different sites (requires COOKIE_SECURE=true)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# ---- Groq LLM ----
GROQ_API_KEY=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
GROQ_MODEL_EXTRACT=llama-3.3-70b-versatile
GROQ_MODEL_EXPLAIN=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30

# ---- Embeddings ----
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---- Uploads / retention ----
MAX_UPLOAD_MB=5
TALENT_POOL_RETENTION_DAYS=365